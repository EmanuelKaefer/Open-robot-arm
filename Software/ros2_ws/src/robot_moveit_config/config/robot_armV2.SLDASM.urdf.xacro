<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_armV2.SLDASM">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robot_armV2.SLDASM urdf file -->
    <xacro:include filename="$(find robot_description)/urdf/robot_armV2SLDASM.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="robot_armV2.SLDASM.ros2_control.xacro" />


    <xacro:robot_armV2.SLDASM_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
