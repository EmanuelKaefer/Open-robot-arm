<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_armV2SLDASM">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_mock_hardware" default="true"/>
    <xacro:arg name="port" default="/dev/ttyACM0"/>
    
    <!-- Import robot_armV2SLDASM urdf file -->
    <xacro:include filename="$(find robot_description)/urdf/robot_armV2SLDASM.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="robot_armV2SLDASM.ros2_control.xacro" />


<xacro:robot_armV2SLDASM_ros2_control name="ArmSystem"
    initial_positions_file="$(arg initial_positions_file)"
    use_mock_hardware="$(arg use_mock_hardware)"
    port="$(arg port)"/>

</robot>
